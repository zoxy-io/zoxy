{
    "listeners": [
        { "bind": "127.0.0.1:8080", "cluster": "origin", "protocol": "l4" }
    ],
    "clusters": {
        "origin": { "endpoints": ["127.0.0.1:9000"], "check": true }
    },
    "timeouts": {
        "connect_ms": 5000,
        "idle_ms": 60000,
        "drain_deadline_ms": 10000,
        "max_lifetime_ms": 0
    },
    "access_log": { "sink": "stdout" }
}
